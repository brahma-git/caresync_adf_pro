{
	"name": "pl_send_email",
	"properties": {
		"activities": [
			{
				"name": "read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.audit_log WHERE adf_run_id=\n'@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_server",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare email header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "ingestion and transformation process for caresync project has been completed and below is the status"
				}
			},
			{
				"name": "prepare email footer",
				"description": " ",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "for any clarification please contact abc@gmail.com"
				}
			},
			{
				"name": "prepare email subject",
				"description": " ",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Check overall faild count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.env} | @{if(greater(activity('Check overall faild count').output.firstRow.count,0),'FAILED','SUCCESS')} | caresync | master run",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check overall faild count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select count(*) as count from ctrl.audit_log where adf_run_id='@{pipeline().parameters.adf_run_id}' and status!='success'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_server",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare email header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "read all tables status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"subject\":\"@{variables('email_subject')}\"\n\"email receipients\":\"@{pipeline().globalParameters.email_receipent}\n\"body_header\":\"@{variables('body_header')}\"\n\"body_footer\":\"@{variables('body_footer')}\",\n\"status_table\":@{activity('read all tables status').output.value}\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "5c582d97-59d0-4569-9e12-a27b1d4b8b99"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic_apps_body": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}